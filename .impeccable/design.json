  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Save or equip with a copper action.",
      "html": "<button class=\"ds-button ds-primary\">Save design</button>",
      "css": ".ds-button{font:500 17px/1.45 'Alegreya Sans',sans-serif;min-height:42px;padding:8px 15px;border:1px solid #34424e;border-radius:5px;background:transparent;color:#f0eeeb;cursor:pointer;box-shadow:none;transition:background .16s,border-color .16s}.ds-button:hover:not(:disabled){background:#1b2732;border-color:#72818c}.ds-button:focus-visible{outline:2px solid #efb18c;outline-offset:4px}.ds-button:disabled{opacity:.5;cursor:default}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-primary{background:#efb18c;border-color:#efb18c;color:#271b15;font-weight:700}.ds-primary:hover:not(:disabled){background:#f4c4a7;border-color:#f4c4a7}"
    },
